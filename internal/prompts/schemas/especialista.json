{
  "type": "object",
  "additionalProperties": false,
  "required": ["hallazgos", "dudas"],
  "properties": {
    "hallazgos": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["archivo", "linea", "severidad", "origen", "grupo", "que_pasa", "por_que", "solucion", "evidencia"],
        "properties": {
          "archivo": {"type": "string", "description": "Ruta relativa a la raíz del repo."},
          "linea": {"type": "integer"},
          "linea_fin": {"type": "integer", "description": "Última línea, si es un rango."},
          "funcion": {"type": "string", "description": "Función o método afectado, si aplica."},
          "severidad": {"type": "string", "enum": ["critico", "alto", "medio", "bajo"]},
          "origen": {"type": "string", "enum": ["introducido", "activado", "empeorado", "preexistente", "incierto"]},
          "grupo": {"type": "string", "enum": ["A", "B"]},
          "que_pasa": {"type": "string", "description": "Una frase."},
          "por_que": {"type": "string", "description": "Dos líneas como máximo."},
          "solucion": {"type": "string", "description": "Diez líneas como máximo: '- ' código actual, '+ ' código corregido."},
          "evidencia": {"type": "array", "minItems": 1, "items": {"type": "string"}, "description": "Referencias archivo:línea; las de base con el prefijo base:."},
          "regla": {
            "type": "object",
            "additionalProperties": false,
            "required": ["cita", "archivo"],
            "description": "Norma del repo que se viola o que sigue la solución.",
            "properties": {
              "cita": {"type": "string", "description": "Texto exacto de la regla."},
              "archivo": {"type": "string"}
            }
          }
        }
      }
    },
    "dudas": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["archivo", "linea", "texto"],
        "properties": {
          "archivo": {"type": "string"},
          "linea": {"type": "integer"},
          "texto": {"type": "string", "description": "Pregunta breve."}
        }
      }
    }
  }
}
